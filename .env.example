# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
# Order chosen by the head-to-head benchmark (scripts/compare_llms.py): accuracy first, then speed.
# For maximum speed instead, use LLM_PROVIDER_ORDER=groq,gemini
LLM_PROVIDER_ORDER=gemini,groq
# Tried in order within each provider; a busy model is skipped for the next.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Email intake (Gmail): the demo inbox and its 16-character App Password
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Your own address(es) that forward invoices into the inbox, comma-separated
EMAIL_TRUSTED_FORWARDERS=
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
