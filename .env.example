# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Tried in order; a busy model is skipped for the next.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Groq runs first when a key is set (fast); Gemini is the backup.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Email intake (Gmail): the demo inbox and its 16-character App Password
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Your own address(es) that forward invoices into the inbox, comma-separated
EMAIL_TRUSTED_FORWARDERS=
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
