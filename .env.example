# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
# Free key from console.mistral.ai (Experiment plan; turn off "use my data for training" under Admin > Privacy)
MISTRAL_API_KEY=
# The Python parser reads first; AI only when it cannot prove its reading. Then Qwen (fast, text only),
# then Gemini and Mistral, which can also read page images (phone photos, poor scans).
LLM_PROVIDER_ORDER=groq,gemini,mistral
GROQ_MODELS=qwen/qwen3.8-27b
GEMINI_MODELS=gemini-3.5-flash-lite
MISTRAL_MODELS=mistral-medium-2508
# Email intake (Gmail): the demo inbox and its 16-character App Password
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Your own address(es) that forward invoices into the inbox, comma-separated
EMAIL_TRUSTED_FORWARDERS=
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
